  <metadata>
    <id>AppMare.Plugin.InAppBilling</id>
    <version>1.0.0</version>
    <title>AppMare In-App Billing Plugin</title>
    <authors>Ibrahim Elkady</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>readme.md</readme>
    <projectUrl>https://github.com/ibrahimelkady2001/AppMare</projectUrl>
    <description>.NET MAUI Plugin to In-App Billing with StoreKit2 support. Fork with custom StoreKit2 integration.</description>
    <releaseNotes>Initial release with StoreKit2 support.</releaseNotes>
    <copyright>Copyright 2025</copyright>
    <tags>.net maui, ios, android, In-App Billing, purchases, StoreKit2, plugin</tags>
    <repository type="git" url="https://github.com/ibrahimelkady2001/AppMare" />
    <dependencies>
      <group targetFramework="net10.0-ios26.0">
        <dependency id="StoreKit2" version="1.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0-maccatalyst26.0" />
    </dependencies>
  </metadata>
